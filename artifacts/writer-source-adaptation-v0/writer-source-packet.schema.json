{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.writerSourcePacket.v0",
  "title": "Writer Source Packet v0",
  "type": "object",
  "required": [
    "schema_version",
    "source_packet_id",
    "input_kind",
    "input_envelope",
    "primary_source_file",
    "source_files",
    "source_spans",
    "supplied_title",
    "target_duration_seconds",
    "writer_constraints",
    "explicit_unknowns",
    "normalization_operations"
  ],
  "properties": {
    "schema_version": {
      "const": "fff.writerSourcePacket.v0"
    },
    "source_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "input_kind": {
      "enum": [
        "prose_markdown_v0",
        "fragment_bundle_v0",
        "writer_proposal_v0"
      ]
    },
    "input_envelope": {
      "type": "object",
      "required": [
        "relative_path",
        "utf8_byte_size",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string"
        },
        "utf8_byte_size": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "minLength": 64
        }
      }
    },
    "primary_source_file": {
      "$ref": "#/$defs/sourceFile"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceFile"
      }
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceSpan"
      }
    },
    "supplied_title": {
      "type": "string",
      "minLength": 1
    },
    "author_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "intended_audience": {
      "type": [
        "string",
        "null"
      ]
    },
    "writer_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicit_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalization_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "semantic"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "semantic": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "required": [
        "source_file_id",
        "relative_path",
        "media_type",
        "utf8_byte_size",
        "sha256"
      ],
      "properties": {
        "source_file_id": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "utf8_byte_size": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "minLength": 64
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "required": [
        "source_span_id",
        "source_file_id",
        "origin",
        "character_range",
        "byte_range",
        "range_reliability",
        "exact_text",
        "exact_text_sha256"
      ],
      "properties": {
        "source_span_id": {
          "type": "string"
        },
        "source_file_id": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "source",
            "writer_authored_proposal"
          ]
        },
        "character_range": {
          "type": "object",
          "required": [
            "start",
            "end",
            "unit"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "unit": {
              "const": "utf16_code_unit"
            }
          }
        },
        "byte_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        },
        "range_reliability": {
          "enum": [
            "exact",
            "unavailable"
          ]
        },
        "exact_text": {
          "type": "string"
        },
        "exact_text_sha256": {
          "type": "string",
          "minLength": 64
        },
        "structural_role": {
          "type": "string"
        }
      }
    }
  }
}
