{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.writerProposal.v0",
  "title": "Writer Proposal v0",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "input_kind",
    "base_source_packet_id",
    "changes",
    "overall_status",
    "auto_accept_canon_proposals"
  ],
  "properties": {
    "schema_version": {
      "const": "fff.writerProposal.v0"
    },
    "proposal_id": {
      "type": "string"
    },
    "input_kind": {
      "const": "writer_proposal_v0"
    },
    "base_source_packet_id": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "operation",
          "source_span_ids_affected",
          "new_text",
          "new_text_origin",
          "intent",
          "expected_downstream_impact",
          "impact_classification",
          "auto_accept",
          "human_author_required"
        ],
        "properties": {
          "change_id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "add",
              "remove",
              "replace",
              "reorder",
              "clarify",
              "mark_undecided",
              "attach_writer_authored_text"
            ]
          },
          "source_span_ids_affected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "new_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_text_origin": {
            "enum": [
              "none",
              "existing_revision_example",
              "editorial_wording",
              "writer_authored_proposal"
            ]
          },
          "intent": {
            "enum": [
              "editorial_wording",
              "canon_proposal"
            ]
          },
          "expected_downstream_impact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact_classification": {
            "enum": [
              "L0 wording only",
              "L1 subject explanation",
              "L2 relation or section impact",
              "L3 format or structure impact",
              "AUTHOR_DECISION_REQUIRED",
              "FORBIDDEN_UNSUPPORTED_INFERENCE"
            ]
          },
          "auto_accept": {
            "const": false
          },
          "human_author_required": {
            "type": "boolean"
          }
        }
      }
    },
    "overall_status": {
      "enum": [
        "REVIEWABLE_NOT_APPLIED",
        "AUTHOR_DECISION_REQUIRED",
        "FORBIDDEN_UNSUPPORTED_INFERENCE"
      ]
    },
    "auto_accept_canon_proposals": {
      "const": false
    }
  }
}
