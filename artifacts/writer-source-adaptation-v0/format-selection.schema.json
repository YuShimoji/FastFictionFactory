{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.formatSelection.v0",
  "title": "Format Selection v0",
  "type": "object",
  "required": [
    "schema_version",
    "format_selection_id",
    "source_packet_id",
    "format_candidates_supported",
    "capacity_metrics",
    "ranked_candidates",
    "status",
    "selected_format",
    "material_disposition",
    "derivation_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "fff.formatSelection.v0"
    },
    "format_selection_id": {
      "type": "string"
    },
    "source_packet_id": {
      "type": "string"
    },
    "format_candidates_supported": {
      "type": "array",
      "minItems": 6,
      "items": {
        "enum": [
          "CASE_DIGEST",
          "SHORT_DRAMA",
          "SCENE_EXCERPT",
          "PLOT_SUMMARY",
          "LORE_EXPLAINER",
          "TRAILER_PV"
        ]
      }
    },
    "capacity_metrics": {
      "type": "object",
      "required": [
        "target_duration_seconds",
        "source_character_count",
        "named_entity_count",
        "unexplained_named_entity_count",
        "named_entity_first_introduction_count",
        "primary_event_count",
        "enacted_action_count",
        "causal_step_count",
        "missing_causal_link_count",
        "unresolved_major_question_count",
        "exposition_unit_count",
        "required_terminology_count",
        "approximate_narration_character_budget",
        "approximate_subtitle_unit_budget",
        "approximate_shot_budget",
        "candidate_ending_action",
        "information_density_score"
      ],
      "properties": {
        "target_duration_seconds": {
          "type": "integer"
        },
        "source_character_count": {
          "type": "integer"
        },
        "named_entity_count": {
          "type": "integer"
        },
        "unexplained_named_entity_count": {
          "type": "integer"
        },
        "named_entity_first_introduction_count": {
          "type": "integer"
        },
        "primary_event_count": {
          "type": "integer"
        },
        "enacted_action_count": {
          "type": "integer"
        },
        "causal_step_count": {
          "type": "integer"
        },
        "missing_causal_link_count": {
          "type": "integer"
        },
        "unresolved_major_question_count": {
          "type": "integer"
        },
        "exposition_unit_count": {
          "type": "integer"
        },
        "required_terminology_count": {
          "type": "integer"
        },
        "approximate_narration_character_budget": {
          "type": "integer"
        },
        "approximate_subtitle_unit_budget": {
          "type": "integer"
        },
        "approximate_shot_budget": {
          "type": "integer"
        },
        "candidate_ending_action": {
          "type": [
            "object",
            "null"
          ]
        },
        "information_density_score": {
          "type": "number"
        }
      }
    },
    "ranked_candidates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "format_id",
          "decision",
          "acceptance_reasons",
          "rejection_reasons",
          "contract_checks",
          "capacity_fit"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "format_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "ACCEPTED",
              "REJECTED",
              "AUTHOR_DECISION_REQUIRED"
            ]
          },
          "acceptance_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejection_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_checks": {
            "type": "object"
          },
          "capacity_fit": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "SELECTED",
        "AUTHOR_DECISION_REQUIRED"
      ]
    },
    "selected_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_disposition": {
      "type": "object",
      "required": [
        "remove",
        "defer",
        "summarize",
        "move_to_longer_form"
      ],
      "properties": {
        "remove": {
          "type": "array"
        },
        "defer": {
          "type": "array"
        },
        "summarize": {
          "type": "array"
        },
        "move_to_longer_form": {
          "type": "array"
        }
      }
    },
    "derivation_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
