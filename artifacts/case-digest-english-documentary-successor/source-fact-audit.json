        "case-digest-section-01-incident.connection_to_next_section"
      ],
      "claim_type": "section_bridge",
      "evidential_status": "bounded",
      "unsupported_fact_count": 0
    },
    {
      "utterance_id": "cd-doc-en-005",
      "section_id": "case-digest-section-02-investigator",
      "shot_id": "shot-b02-01",
      "spoken_text_en": "Clock repairer Mira Vale follows the evidence because her brother is missing.",
