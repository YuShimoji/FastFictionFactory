{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.densou.seriesManifest.v1",
  "title": "Densou Series Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series_id",
    "material_label",
    "source_packet_id",
    "source_revision_id",
    "state",
    "seasons",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "fff.densou.seriesManifest.v1" },
    "series_id": { "const": "densou-series" },
    "material_label": { "const": "デンソウ" },
    "source_packet_id": { "type": "string", "minLength": 1 },
    "source_revision_id": { "type": "string", "pattern": "^densou-[0-9a-f]{16}$" },
    "state": { "const": "source_bound_not_adapted" },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["season_id", "manifest_path", "state"],
        "properties": {
          "season_id": { "type": "string" },
          "manifest_path": { "type": "string" },
          "state": { "const": "source_bound_planning_pending" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "external_provider", "credentials", "release", "final_canon"],
      "properties": {
        "publication": { "const": false },
        "external_provider": { "const": false },
        "credentials": { "const": false },
        "release": { "const": false },
        "final_canon": { "const": false }
      }
    }
  }
}
