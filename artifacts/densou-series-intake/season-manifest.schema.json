{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.densou.seasonManifest.v1",
  "title": "Densou Season Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series_id",
    "season_id",
    "source_packet_id",
    "source_revision_id",
    "state",
    "episodes"
  ],
  "properties": {
    "schema_version": { "const": "fff.densou.seasonManifest.v1" },
    "series_id": { "const": "densou-series" },
    "season_id": { "pattern": "^season-[0-9]{3}$" },
    "source_packet_id": { "type": "string", "minLength": 1 },
    "source_revision_id": { "type": "string", "pattern": "^densou-[0-9a-f]{16}$" },
    "state": { "const": "source_bound_planning_pending" },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_id", "manifest_path", "state"],
        "properties": {
          "episode_id": { "pattern": "^episode-[0-9]{3}$" },
          "manifest_path": { "type": "string" },
          "state": { "const": "source_bound_adaptation_pending" }
        }
      }
    }
  }
}
