    "subtitle_cues": [
      {
        "cue_index": 1,
        "start_seconds": 0,
        "end_seconds": 12,
        "text_ja": "正午、鐘のない塔から鐘の音が響いたと報告された。"
      },
      {
        "cue_index": 2,
        "start_seconds": 12,
        "end_seconds": 24,
        "text_ja": "塔の取付枠は空で、鐘は確認できない。"
      },
      {
        "cue_index": 3,
        "start_seconds": 24,
        "end_seconds": 38,
        "text_ja": "時計修理師のミラ・ヴェイルが、失踪した兄の手掛かりを調べる。"
      },
      {
        "cue_index": 4,
        "start_seconds": 38,
        "end_seconds": 52,
        "text_ja": "失踪した兄のメモと真鍮の蛾が、作業台に残されている。"
      },
      {
        "cue_index": 5,
        "start_seconds": 52,
        "end_seconds": 65,
        "text_ja": "時計と記録には、9:17が繰り返し現れる。"
      },
      {
        "cue_index": 6,
        "start_seconds": 65,
        "end_seconds": 81,
        "text_ja": "失踪した兄のメモは、二列の台帳へ調査を導く。"
      },
      {
        "cue_index": 7,
        "start_seconds": 81,
        "end_seconds": 97,
        "text_ja": "台帳には、「分」の欄と人名の欄が並んでいる。"
      },
      {
        "cue_index": 8,
        "start_seconds": 97,
        "end_seconds": 116,
        "text_ja": "メモは、市の評議会を調査対象として指している。"
      },
      {
        "cue_index": 9,
        "start_seconds": 116,
        "end_seconds": 136,
        "text_ja": "告発は記録されているが、評議会の関与を裏づける証拠はない。"
      },
      {
        "cue_index": 10,
        "start_seconds": 136,
        "end_seconds": 158,
        "text_ja": "時間と名前は、台帳の二つの損失区分である。"
      },
      {
        "cue_index": 11,
        "start_seconds": 158,
        "end_seconds": 180,
        "text_ja": "音源と関係者を確定できないまま、塔は調査対象として残る。"
      }
    ],
    "watermark_text": "CASE DIGEST / PRIVATE / NOT FOR PUBLICATION"
