{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fff.rawMarkdownIntake.v1",
  "title": "Raw Markdown Intake v1",
  "type": "object",
  "required": [
    "schema_version",
    "intake_id",
    "source",
    "metadata",
    "newline_normalization",
    "line_spans",
    "segments",
    "reconstruction_passed",
    "input_json_embeds_full_prose",
    "semantic_normalization_performed"
  ],
  "properties": {
    "schema_version": { "const": "fff.rawMarkdownIntake.v1" },
    "intake_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": [
        "relative_path",
        "media_type",
        "utf8_byte_size",
        "utf8_sha256",
        "text_character_count",
        "exact_text_sha256"
      ],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "media_type": {
          "type": "string",
          "enum": ["text/markdown", "text/plain"]
        },
        "utf8_byte_size": { "type": "integer", "minimum": 0 },
        "utf8_sha256": { "type": "string", "minLength": 64 },
        "text_character_count": { "type": "integer", "minimum": 0 },
        "exact_text_sha256": { "type": "string", "minLength": 64 }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["relative_path", "sha256", "source_id"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64 },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "newline_normalization": {
      "type": "object",
      "required": [
        "target",
        "non_semantic",
        "original_counts",
        "mapping",
        "normalized_text_sha256"
      ],
      "properties": {
        "target": { "const": "LF" },
        "non_semantic": { "const": true },
        "original_counts": { "type": "object" },
        "mapping": { "type": "array" },
        "normalized_text_sha256": { "type": "string", "minLength": 64 }
      }
    },
    "line_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line_number",
          "character_range",
          "byte_range",
          "normalized_character_range",
          "line_text_sha256",
          "newline_kind"
        ]
      }
    },
    "segments": { "type": "array", "minItems": 1 },
    "reconstruction_passed": { "const": true },
    "input_json_embeds_full_prose": { "const": false },
    "semantic_normalization_performed": { "const": false }
  },
  "additionalProperties": false
}
